# Secrets
.env

# Training data and pulled server copies — large, regenerate with
# `python -m knyc.build_training_data`
data/

# Everything the live bot writes (logs, tape, state, chart) — kept per host so
# `git pull` on a deployed VM never conflicts with its prediction history.
logs/
# Pre-2026-11-16 layout kept these in the repo root; the bot moves them into
# logs/ on its first start after the update.
/nowcast_log.csv
/market_log.csv
/prediction_tape.csv
/bot_state.json
/daily_chart.png
/knyc_training.csv

# Local analysis notebook (large outputs)
notebooks/analyze_nowcast_log.ipynb

# Python
__pycache__/
*.pyc

# Backups / scratch
*.bak

# Local Claude Code settings
.claude/

# Candidate model binaries - regenerate with python -m knyc.train_guidance
models/candidates/**/*.pkl
